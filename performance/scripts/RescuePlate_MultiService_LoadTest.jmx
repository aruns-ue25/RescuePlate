              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <stringProp name="Argument.value">{&quot;title&quot;: &quot;Emergency Food Need Request ${__Random(1000,9999)}&quot;, &quot;category&quot;: &quot;Cooked Meals&quot;, &quot;quantityNeeded&quot;: 50, &quot;unit&quot;: &quot;portions&quot;, &quot;description&quot;: &quot;Hot meal support for community feeding program.&quot;, &quot;location&quot;: &quot;350 W 42nd St, New York, NY&quot;, &quot;neededByDate&quot;: &quot;${__groovy(java.time.Instant.now().plus(java.time.Duration.ofDays(7)).toString())}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
